# Copy to .env in the project root (the backend loads it automatically).
DATAVERSE_DB_PATH=backend/dataverse.db
DATAVERSE_STORAGE=backend/storage
DATAVERSE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: enables the AI Data Analyst. Without it, everything else still works.
GEMINI_API_KEY=
# If this model name is retired, set any current Gemini model name here.
GEMINI_MODEL=gemini-2.0-flash
